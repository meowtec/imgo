---
import logoImg from '../assets/logo.png';
import { getSiteCopy, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
const { appLabel, loading } = copy.workbench;
---

<div class="app-window" role="region" aria-label={appLabel}>
  <div class="app-window__titlebar" aria-hidden="true">
    <div class="app-window__identity">
      <span
        class="app-window__mark"
        style={`--app-window-logo: url("${logoImg.src}")`}
      ></span>
      <span class="app-window__title">IMGo</span>
      <span class="app-window__edition">WEB ENGINE</span>
    </div>
    <div class="app-window__status">
      <span class="app-window__signal"></span>
      <span>LOCAL</span>
      <span class="app-window__divider"></span>
      <span>WASM</span>
    </div>
  </div>
  <div class="app-window__content">
    <div
      id="imgo-root"
      class="app-window__root"
      data-lazy="true"
      data-locale={locale}
      aria-label={appLabel}
      aria-busy="true"
    >
      <span class="app-window__loading">{loading}</span>
    </div>
  </div>
</div>

<script>
  import '../scripts/mount-app';
</script>

<style>
  /* Hallmark · pre-emit critique: P4 H4 E4 S5 R5 V4 */
  /* Hallmark · component: embedded workbench shell · genre: modern-minimal · theme: Coral
   * direction: precision image engine · designed-as-app · design-system: design.md · contrast: pass
   */
  .app-window {
    width: min(100%, var(--app-max));
    margin-inline: auto;
    overflow: clip;
    border: var(--rule-hair) solid var(--color-window-rule);
    border-radius: var(--radius-window);
    background: var(--color-surface);
    box-shadow: var(--shadow-window);
  }

  .app-window__titlebar {
    display: flex;
    min-height: var(--window-titlebar-height);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-inline: var(--space-md);
    background: var(--color-window-bar);
    color: var(--color-window-ink);
    user-select: none;
  }

  .app-window__identity,
  .app-window__status {
    display: flex;
    min-width: 0;
    align-items: center;
  }

  .app-window__identity {
    gap: var(--space-xs);
  }

  .app-window__mark {
    width: var(--window-mark-size);
    height: var(--window-mark-size);
    flex: 0 0 auto;
    background: var(--color-window-accent);
    mask: var(--app-window-logo) center / contain no-repeat;
    -webkit-mask: var(--app-window-logo) center / contain no-repeat;
  }

  .app-window__title,
  .app-window__edition,
  .app-window__status {
    font-family: var(--font-mono);
    letter-spacing: 0;
    line-height: 1;
  }

  .app-window__title {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .app-window__edition {
    overflow: hidden;
    color: var(--color-window-muted);
    font-size: var(--text-xs);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .app-window__status {
    flex: 0 0 auto;
    gap: var(--space-xs);
    color: var(--color-window-muted);
    font-size: var(--text-xs);
  }

  .app-window__signal {
    width: var(--window-signal-size);
    height: var(--window-signal-size);
    border-radius: var(--radius-round);
    background: var(--color-window-accent);
    box-shadow: 0 0 0 var(--space-3xs) var(--color-window-accent-soft);
  }

  .app-window__divider {
    width: var(--rule-hair);
    height: var(--space-sm);
    background: var(--color-window-rule-dark);
  }

  .app-window__content {
    position: relative;
    min-width: 0;
    min-height: var(--window-content-height);
    overflow: clip;
    background: var(--color-surface);
  }

  .app-window__root {
    position: relative;
    min-width: 0;
    min-height: var(--window-content-height);
  }

  .app-window__loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 30rem) {
    .app-window__edition,
    .app-window__divider,
    .app-window__status span:last-child {
      display: none;
    }

    .app-window__titlebar {
      padding-inline: var(--space-sm);
    }
  }
</style>
