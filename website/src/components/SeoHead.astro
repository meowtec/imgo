---
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  pathname: string;
  alternatePathname?: string;
  image: string;
  noindex?: boolean;
  jsonLd?: Array<Record<string, unknown>>;
}

const {
  locale,
  title,
  description,
  pathname,
  alternatePathname,
  image,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const baseUrl = Astro.site ?? new URL('https://imgo.app');
const canonicalUrl = new URL(pathname, baseUrl);
const imageUrl = new URL(image, baseUrl);
const alternateUrl = alternatePathname ? new URL(alternatePathname, baseUrl) : null;
const ogLocale = locale === 'en' ? 'en_US' : 'zh_CN';
const alternateOgLocale = locale === 'en' ? 'zh_CN' : 'en_US';
---

<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
<link rel="canonical" href={canonicalUrl} />
{
  alternateUrl && (
    <>
      <link rel="alternate" hreflang={locale === 'en' ? 'zh-CN' : 'en'} href={alternateUrl} />
      <link
        rel="alternate"
        hreflang={locale === 'en' ? 'en' : 'zh-CN'}
        href={canonicalUrl}
      />
      <link rel="alternate" hreflang="x-default" href={new URL('/', baseUrl)} />
    </>
  )
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content="IMGo" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={alternateOgLocale} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={title} />

<title>{title}</title>

{
  jsonLd.map((item) => (
    <script type="application/ld+json" set:html={JSON.stringify(item)} />
  ))
}
