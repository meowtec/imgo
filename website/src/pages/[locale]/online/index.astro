---
import AppShellLayout from '../../../layouts/AppShellLayout.astro';
import { getSiteCopy, localeRoutes, locales, type Locale } from '../../../i18n';
import '../../../../tokens.css';
import '../../../../../app/src/styles/base.css';

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== 'en')
    .map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const copy = getSiteCopy(locale);
const routes = localeRoutes[locale];
---

<AppShellLayout
  {locale}
  title={copy.seo.appTitle}
  description={copy.seo.appDescription}
  pathname={routes.app}
  image={locale === 'zh' ? '/og/imgo-zh.png' : '/og/imgo-en.png'}
>
  <div class="online-shell">
    <div
      id="imgo-root"
      class="online-app"
      data-home-href={routes.home}
      data-locale={locale}
    ></div>
  </div>
</AppShellLayout>

<script>
  import '../../../scripts/mount-app';
</script>

<style>
  .online-shell {
    display: flex;
    min-height: 100dvh;
    flex-direction: column;
    background: var(--color-paper);
    color: var(--color-ink-2);
  }

  .online-app {
    flex: 1;
    min-width: 0;
  }
</style>
