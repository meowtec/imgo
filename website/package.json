{
  "name": "@imgo/web",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "generate:i18n": "pnpm --dir ../app exec tsx scripts/i18n-gen.ts",
    "predev": "pnpm run generate:i18n",
    "dev": "astro dev",
    "prebuild": "pnpm run generate:i18n",
    "build": "astro build",
    "build:site": "astro build",
    "deploy": "pnpm --dir .. run build && pnpm exec wrangler pages deploy dist",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@imgo/minifier-js": "workspace:^",
    "astro": "^7.1.3",
    "astro-icon": "^1.1.5",
    "clsx": "^2.1.1",
    "@imgo/app": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.4",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "vite-plugin-svg-sprite": "^0.7.0",
    "vite-plugin-wasm": "^3.6.0",
    "wrangler": "^4.123.0"
  }
}
