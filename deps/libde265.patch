 {
 #if HAVE_AVX512
-#if defined(__GNUC__) && !defined(__EMSCRIPTEN__)
+#if defined(__GNUC__) && !defined(__EMSCRIPTEN__) && !defined(__APPLE__)
   __builtin_cpu_init();
   // need AVX-512F + AVX-512BW (16-bit ops). __builtin_cpu_supports handles the
